# El Torneo de las Leyendas — variables de entorno
# Copiar a .env.local para desarrollo. En Vercel: Settings → Environment Variables

# URL del video del Home (cuando lo subas). Si está vacío se muestra el placeholder.
NEXT_PUBLIC_HOME_VIDEO_URL=

# ── Próxima etapa (todavía no se usan) ──
# Base de datos: MongoDB Atlas
MONGODB_URI=
# Storage de archivos (videos/fotos): Vercel Blob
BLOB_READ_WRITE_TOKEN=
