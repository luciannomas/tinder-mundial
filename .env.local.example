# ─────────────────────────────────────────────────────────────────
# FiguSwap — Variables de entorno
# Copiá este archivo como .env.local para desarrollo local
# En Vercel: Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────

# ── MONGODB (OBLIGATORIO) ─────────────────────────────────────────
# Creá un cluster gratis en https://cloud.mongodb.com
# → Create cluster → Connect → Connect your application → copia la URL
# Reemplazá <password> por tu contraseña y <dbname> por "figuswap"
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/figuswap?retryWrites=true&w=majority

# ── NEXTAUTH (OBLIGATORIO) ────────────────────────────────────────
# Generá un secret con: openssl rand -base64 32
NEXTAUTH_SECRET=pon-aqui-un-string-aleatorio-de-al-menos-32-caracteres

# URL de tu app (en Vercel es tu dominio, ej: https://figuswap.vercel.app)
NEXTAUTH_URL=http://localhost:3000

# ── GOOGLE OAUTH (OPCIONAL) ───────────────────────────────────────
# Si querés login con Google: https://console.cloud.google.com
# → APIs & Services → Credentials → OAuth 2.0 Client ID
# URI de redireccionamiento: https://tu-dominio.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
